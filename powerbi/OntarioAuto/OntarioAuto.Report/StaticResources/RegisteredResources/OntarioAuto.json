              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E9EDF3"
              }
            },
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "legend": [
          {
            "show": true,
