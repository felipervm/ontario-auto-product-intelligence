    "lineClusteredColumnComboChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E9EDF3"
              }
            },
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E9EDF3"
              }
            },
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#0033A0"
