                "textRuns": [
                  {
                    "value": "Duplicate keys: more than one row per period x region x segment x coverage.   Invalid measure rows: exposure or premium <= 0, or claim count / incurred losses < 0.   Missing values: any blank field in a row.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2A41",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              },
              {
                "textRuns": [
                  {
                    "value": "Ratios are computed from sums (loss ratio = incurred losses / earned premium; frequency = claims / exposures; severity = losses / claims; pure premium = losses / exposures), never as averages of row-level ratios.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2A41",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              },
              {
                "textRuns": [
                  {
                    "value": "Earned exposures are coverage-level units, not distinct insured vehicles. The 2026 frequency uplift for Toronto and GTA Other Collision / Accident Benefits is a modelled scenario assumption, not a finding about the real Ontario market. Loss-ratio colour thresholds (55% / 70%) are a reporting convention for this case study, not regulatory benchmarks.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#5B6B82",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              }
