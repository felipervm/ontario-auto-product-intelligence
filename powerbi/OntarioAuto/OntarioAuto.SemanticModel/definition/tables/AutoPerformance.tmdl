table AutoPerformance
	lineageTag: 6f0c428f-af5d-5b7a-b4a4-e633edf9c6bc

	measure 'Earned Premium' = SUM(AutoPerformance[earned_premium_cad])
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 317f51fb-0807-53d1-a5b3-2db1c4bd6d0e

	measure 'Incurred Losses' = SUM(AutoPerformance[incurred_losses_cad])
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 11459320-4ff6-5486-b261-9a0891944b15

	measure 'Earned Exposures' = SUM(AutoPerformance[earned_exposures])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 704a36ac-928d-5d32-99d6-873f01956ca3

	measure 'Claim Count' = SUM(AutoPerformance[claim_count])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 60bd74fa-a353-5d97-a79d-bec6022c53a5

	measure 'Loss Ratio' = DIVIDE([Incurred Losses], [Earned Premium])
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 654c8dcb-034a-5863-94ff-19e21ed05a24

	measure 'Claim Frequency' = DIVIDE([Claim Count], [Earned Exposures])
		formatString: 0.00%
		displayFolder: 1 Core
		lineageTag: a3a682a2-5e55-56b3-9959-db5a8f8d9cb0

	measure 'Claim Severity' = DIVIDE([Incurred Losses], [Claim Count])
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 23cab948-1030-5ebf-aae8-4fdd3dac474f

	measure 'Pure Premium' = DIVIDE([Incurred Losses], [Earned Exposures])
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 47a76a36-5d4a-5b64-9983-1f178296dba3

	measure 'Avg Premium per Exposure' = DIVIDE([Earned Premium], [Earned Exposures])
		formatString: \$#,0
		displayFolder: 1 Core
		lineageTag: 8a6e142d-ea2f-5c46-8ec4-02c11507c7bb

	measure 'Loss Ratio YoY (pts)' =
			VAR cy = MAX(AutoPerformance[year])
			VAR py = CALCULATE([Loss Ratio], REMOVEFILTERS(AutoPerformance[year]), AutoPerformance[year] = cy - 1)
			RETURN IF(NOT ISBLANK(py), ([Loss Ratio] - py) * 100)
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: 2 Year over Year
		lineageTag: 3c6160b2-3cfa-5e05-a928-25173fa399b6

	measure 'Claim Frequency YoY %' =
			VAR cy = MAX(AutoPerformance[year])
			VAR py = CALCULATE([Claim Frequency], REMOVEFILTERS(AutoPerformance[year]), AutoPerformance[year] = cy - 1)
			RETURN IF(NOT ISBLANK(py) && py <> 0, DIVIDE([Claim Frequency], py) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Year over Year
		lineageTag: 9651a235-4528-555c-a2b5-ddad32334e78

	measure 'Claim Severity YoY %' =
			VAR cy = MAX(AutoPerformance[year])
			VAR py = CALCULATE([Claim Severity], REMOVEFILTERS(AutoPerformance[year]), AutoPerformance[year] = cy - 1)
			RETURN IF(NOT ISBLANK(py) && py <> 0, DIVIDE([Claim Severity], py) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Year over Year
		lineageTag: 9d31a029-ef52-5d43-9922-48b318e77c05

	measure 'Premium Rate YoY %' =
			VAR cy = MAX(AutoPerformance[year])
			VAR py = CALCULATE([Avg Premium per Exposure], REMOVEFILTERS(AutoPerformance[year]), AutoPerformance[year] = cy - 1)
			RETURN IF(NOT ISBLANK(py) && py <> 0, DIVIDE([Avg Premium per Exposure], py) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Year over Year
		lineageTag: 65312780-ed14-5dee-9d51-f72735c322ca

	measure 'LR Status Color' =
			VAR lr = [Loss Ratio]
			RETURN SWITCH(TRUE(), ISBLANK(lr), BLANK(), lr > 0.70, "#D0021B", lr > 0.55, "#F2A900", "#00875A")
		isHidden
		displayFolder: 9 Formatting
		lineageTag: 7135fcd4-6b52-52c1-a5bc-72e184694fcf

	measure 'LR Status Fill' =
			VAR lr = [Loss Ratio]
			RETURN SWITCH(TRUE(), ISBLANK(lr), BLANK(), lr > 0.70, "#FAD7DB", lr > 0.55, "#FDEFC2", "#D3EFE3")
		isHidden
		displayFolder: 9 Formatting
		lineageTag: 40e47d52-ca47-5c46-9aaf-f5046ddd7afa

	measure 'Row Count' = COUNTROWS(AutoPerformance)
		formatString: #,0
		displayFolder: 3 Data Quality
		lineageTag: 87adab6f-0e39-528d-9751-8245154e9595

	measure 'Rows Loaded' = [Row Count]
		formatString: #,0
		displayFolder: 3 Data Quality
		lineageTag: 15c36c28-cc68-54ae-bc1e-b0a549b656d8

	measure 'Periods Covered' = DISTINCTCOUNT(AutoPerformance[period])
		formatString: 0
		displayFolder: 3 Data Quality
		lineageTag: bfe5b2f6-4bf4-540b-ac18-443bd615b8f1

	measure 'Duplicate Keys' =
			VAR keys = SUMMARIZE(AutoPerformance, AutoPerformance[period], AutoPerformance[region], AutoPerformance[segment], AutoPerformance[coverage], "n", COUNTROWS(AutoPerformance))
			RETURN COALESCE(COUNTROWS(FILTER(keys, [n] > 1)), 0)
		formatString: #,0
		displayFolder: 3 Data Quality
		lineageTag: f71f00fe-e64f-5586-8c48-a8b0776fa6f6

	measure 'Invalid Measure Rows' = COALESCE(COUNTROWS(FILTER(AutoPerformance, AutoPerformance[earned_exposures] <= 0 || AutoPerformance[earned_premium_cad] <= 0 || AutoPerformance[claim_count] < 0 || AutoPerformance[incurred_losses_cad] < 0)), 0)
		formatString: #,0
		displayFolder: 3 Data Quality
		lineageTag: b78e4a2a-f9bd-5f7d-8340-cf4c5625638e

	measure 'Rows with Missing Values' = COALESCE(COUNTROWS(FILTER(AutoPerformance, ISBLANK(AutoPerformance[period]) || ISBLANK(AutoPerformance[year]) || ISBLANK(AutoPerformance[quarter]) || ISBLANK(AutoPerformance[region]) || ISBLANK(AutoPerformance[segment]) || ISBLANK(AutoPerformance[coverage]) || ISBLANK(AutoPerformance[earned_exposures]) || ISBLANK(AutoPerformance[earned_premium_cad]) || ISBLANK(AutoPerformance[claim_count]) || ISBLANK(AutoPerformance[incurred_losses_cad]))), 0)
		formatString: #,0
		displayFolder: 3 Data Quality
		lineageTag: 244e936c-b507-51b6-9504-5ce34cb0750c

	measure 'Quality Check Status' = IF(COALESCE([Duplicate Keys], 0) + COALESCE([Invalid Measure Rows], 0) + COALESCE([Rows with Missing Values], 0) = 0, "ALL PASSED", "REVIEW")
		displayFolder: 3 Data Quality
		lineageTag: ed2e06c3-c49b-5d6b-9d2d-c8614fd1782b

	measure 'DQ Status Color' = IF(COALESCE([Duplicate Keys], 0) + COALESCE([Invalid Measure Rows], 0) + COALESCE([Rows with Missing Values], 0) = 0, "#00875A", "#D0021B")
		isHidden
		displayFolder: 9 Formatting
		lineageTag: 35e4b1a0-4379-51d9-add8-5190c62519b1

	column period
		dataType: string
		lineageTag: fad4356c-cb24-554c-966f-c81880d53721
