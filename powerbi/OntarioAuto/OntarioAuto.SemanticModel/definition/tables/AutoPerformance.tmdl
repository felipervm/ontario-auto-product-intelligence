		sourceColumn: period

	column year
		dataType: int64
		formatString: 0
		lineageTag: f51dcab9-95e8-5a58-b35d-ffe0baa3e3fe
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 2a2ebc10-4bcf-5a07-b644-b3ccc24fa09d
		summarizeBy: none
		sourceColumn: quarter

	column region
		dataType: string
		lineageTag: 5a1a61a1-8a82-5de5-87d5-15e21b22d21a
		summarizeBy: none
		sourceColumn: region

	column segment
		dataType: string
		lineageTag: 66d64401-1c91-5562-a311-67739f658d67
		summarizeBy: none
		sourceColumn: segment

	column coverage
		dataType: string
		lineageTag: 9cd74d1a-9b25-5224-b54d-52f89ea4c5ac
		summarizeBy: none
		sourceColumn: coverage

	column earned_exposures
		dataType: double
		formatString: #,0.00
		lineageTag: 24adb042-44b1-541c-bde9-b5568acab296
		summarizeBy: sum
		sourceColumn: earned_exposures

	column earned_premium_cad
		dataType: double
		formatString: \$#,0.00
		lineageTag: 85e6e30e-0f15-58ec-8551-fd50f9af5d12
		summarizeBy: sum
		sourceColumn: earned_premium_cad

	column claim_count
		dataType: int64
		formatString: #,0
		lineageTag: 02db1cbb-a7fe-59c5-b0f7-ee140e0b9c81
		summarizeBy: sum
		sourceColumn: claim_count

	column incurred_losses_cad
		dataType: double
		formatString: \$#,0.00
		lineageTag: 7c46cdbe-c369-50d8-9e92-7a1f6d2af30e
		summarizeBy: sum
		sourceColumn: incurred_losses_cad

	column 'Year Label' = FORMAT(AutoPerformance[year], "0")
		dataType: string
		lineageTag: 21849196-a1e4-545d-a3a5-4eb13396cdf5
		summarizeBy: none

	partition AutoPerformance = m
		mode: import
		source =
				let
					// Data is embedded (gzip + base64 of data/synthetic_ontario_auto_quarterly.csv) so the report opens with zero setup.
					// To read the CSV from disk instead, replace Source with:
					//   Csv.Document(File.Contents("C:\path\to\data\synthetic_ontario_auto_quarterly.csv"), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.None])
					Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"period", type text}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"region", type text}, {"segment", type text}, {"coverage", type text}, {"earned_exposures", type number}, {"earned_premium_cad", type number}, {"claim_count", Int64.Type}, {"incurred_losses_cad", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table

